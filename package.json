{
  "name": "my-qwik-empty-starter",
  "description": "Blank project with routing included",
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "qwik check-client src dist && vite build -c adapters/cloudflare-pages/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "wrangler pages deploy ./dist",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "biome check --write .",
    "fmt.check": "biome check .",
    "lint": "biome check .",
    "preview": "qwik build preview && vite preview --open",
    "qwik-speak-extract": "qwik-speak-extract --supportedLangs=fr-FR,en-US,es-CO --assetsPath=public/i18n --autoKeys=true --runtimeAssets=runtime",
    "serve": "wrangler pages dev ./dist --compatibility-flags=nodejs_als",
    "start": "vite --open --mode ssr",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@builder.io/qwik": "^1.20.0",
    "@builder.io/qwik-city": "^1.20.0",
    "@playwright/test": "^1.62.1",
    "@qwik-ui/headless": "^0.7.7",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "20.19.0",
    "@unpic/qwik": "^1.0.0",
    "playwright": "^1.62.1",
    "qwik-speak": "^0.24.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.4.5",
    "typescript-plugin-css-modules": "latest",
    "undici": "^8.10.0",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "^4.3.2",
    "wrangler": "^3.114.17"
  },
  "dependencies": {
    "@arrirpc/schema": "^0.83.1",
    "@cloudflare/vite-plugin": "^1.50.0",
    "openai": "^6.49.0"
  }
}
